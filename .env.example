# ---- Host ports (docker-compose) ----
# Override these to avoid clashing with other solutions on the same machine.
# They only affect the host side; container-internal ports are unchanged.
#   Dashboard  -> http://localhost:${WEB_PORT}
#   API/Swagger-> http://localhost:${API_PORT}/docs
#   Postgres   -> localhost:${DB_PORT}
WEB_PORT=5173
API_PORT=8000
DB_PORT=5432

# ---- Database ----
# Async SQLAlchemy URL used by the app (psycopg v3 driver).
DATABASE_URL=postgresql+psycopg://copilot:copilot@db:5432/copilot

# Credentials for the bundled Postgres container (docker-compose).
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot

# ---- Security ----
# Signs session/JWT tokens for the password gate. Change in production.
SECRET_KEY=dev-insecure-change-me
# Fernet key for encrypting the Graph client secret at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# First-run admin bootstrap (only created when no app users exist yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_DIST=frontend/dist

# ---- Ingest tuning ----
INGEST_CONCURRENCY=15
DEFAULT_BACKFILL_DAYS=30

# ---- Analysis (Azure OpenAI) tuning ----
# The Azure OpenAI endpoint, deployment, api-version and key are entered in the
# in-app Settings (stored encrypted in the database), NOT here. These two only
# tune how the analysis stage runs.
# Conversations analysed concurrently (keep modest for AOAI TPM/RPM quotas).
ANALYSIS_CONCURRENCY=5
# Run the LLM analysis stage automatically after each ingest.
ANALYSE_AFTER_INGEST=true
