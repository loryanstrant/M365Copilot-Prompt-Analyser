# ---- Host ports (docker-compose) ----
# Override these to avoid clashing with other solutions on the same machine.
# They only affect the host side; container-internal ports are unchanged.
#   Dashboard + API -> http://localhost:${API_PORT}        (production)
#   API/Swagger     -> http://localhost:${API_PORT}/docs
#   Postgres        -> localhost:${DB_PORT}
#   Vite dev server -> http://localhost:${WEB_PORT}        (dev override only)
#
# Each solution in the suite owns a distinct block so all four run side by side:
#   Usage Reporter 5432/8000 | Cowork Reporter 5433/8001
#   Agent Quality  5434/8002 | Prompt Analyser 5435/8003
#
# In production the API serves the built SPA, so WEB_PORT applies only to
# docker-compose.dev.yml, which runs the Vite dev server.
API_PORT=8003
DB_PORT=5435
WEB_PORT=5176

# ---- Container images (production compose) ----
# Defaults are the public GHCR images published from the GitHub mirror.
# To run the images built by Gitea Actions instead, set:
#   API_IMAGE=gitea.strant.casa/loryanstrant/m365copilot-prompt-analyser-api:latest
#   WORKER_IMAGE=gitea.strant.casa/loryanstrant/m365copilot-prompt-analyser-worker:latest
# Leave blank for the defaults, or run `docker compose build` to build locally.
API_IMAGE=
WORKER_IMAGE=

# ---- Database ----
# Async SQLAlchemy URL used by the app (psycopg v3 driver).
DATABASE_URL=postgresql+psycopg://copilot:copilot@db:5432/copilot

# Credentials for the bundled Postgres container (docker-compose).
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot

# ---- Security ----
# Signs session/JWT tokens for the password gate. Change in production.
SECRET_KEY=dev-insecure-change-me
# Fernet key for encrypting the Graph client secret at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# First-run admin bootstrap (only created when no app users exist yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_DIST=frontend/dist

# ---- Ingest tuning ----
INGEST_CONCURRENCY=15
DEFAULT_BACKFILL_DAYS=30

# ---- Analysis (Azure OpenAI) tuning ----
# The Azure OpenAI endpoint, deployment, api-version and key are entered in the
# in-app Settings (stored encrypted in the database), NOT here. These two only
# tune how the analysis stage runs.
# Conversations analysed concurrently (keep modest for AOAI TPM/RPM quotas).
ANALYSIS_CONCURRENCY=5
# Run the LLM analysis stage automatically after each ingest.
ANALYSE_AFTER_INGEST=true
